// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

enum TeacherStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum EnrollmentStatus {
  DEMO_PENDING
  DEMO_COMPLETED
  ACTIVE
  PAUSED
  CANCELLED
}

enum ClassStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum AssignmentStatus {
  ASSIGNED
  SUBMITTED
  GRADED
  OVERDUE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentType {
  ONE_TIME
  SUBSCRIPTION
}

enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  CLASS_REMINDER
  ASSIGNMENT
  PAYMENT
  DEMO
  SYSTEM
  MESSAGE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SyllabusStatus {
  UPLOADED
  PROCESSING
  PARSED
  FAILED
}

enum StudyPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum FeedbackType {
  TEACHER_FEEDBACK
  STUDENT_FEEDBACK
}

// ============================================
// USER & PROFILES
// ============================================

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String?
  name           String
  phone          String?
  role           UserRole
  avatarUrl      String?
  timezone       String    @default("Asia/Kolkata")
  isActive       Boolean   @default(true)
  emailVerified  DateTime?
  googleId       String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  studentProfile  StudentProfile?
  teacherProfile  TeacherProfile?
  sentMessages    Message[]       @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  notifications   Notification[]
  demoFeedbacks   DemoFeedback[]
  accounts        Account[]
  sessions        Session[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model StudentProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  parentId            String?
  grade               String?
  board               String?
  school              String?
  subjects            String[] @default([])
  currentLevel        String?
  targetGoal          String?
  preferredLanguage   String   @default("English")
  preferredDuration   Int      @default(60) // minutes
  preferredDays       DayOfWeek[] @default([])
  preferredTimeRanges Json?    // [{start: "16:00", end: "20:00"}]
  monthlyBudget       Int?     // in INR
  learningPreferences String?
  examDate            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability       StudentAvailability[]
  syllabi            Syllabus[]
  studyPlans         StudyPlan[]
  enrollments        Enrollment[]
  demoClasses        DemoClass[]        @relation("StudentDemos")
  scheduledClasses   ScheduledClass[]   @relation("StudentClasses")
  assignments        Assignment[]       @relation("StudentAssignments")
  submissions        AssignmentSubmission[]
  payments           Payment[]
  subscriptions      Subscription[]
  reviews            Review[]           @relation("StudentReviews")

  @@map("student_profiles")
}

model TeacherProfile {
  id                        String        @id @default(uuid())
  userId                    String        @unique
  bio                       String?       @db.Text
  education                 String?
  university                String?
  qualifications            String[]      @default([])
  experienceYears           Int           @default(0)
  subjects                  String[]      @default([])
  grades                    String[]      @default([])
  boards                    String[]      @default([])
  languages                 String[]      @default(["English"])
  teachingStyle             String?
  hourlyRate                Int?          // in INR
  monthlyRate               Int?          // in INR
  maxStudents               Int           @default(20)
  currentStudents           Int           @default(0)
  rating                    Float         @default(0)
  totalReviews              Int           @default(0)
  demoVideoUrl              String?
  isVerified                Boolean       @default(false)
  isApproved                Boolean       @default(false)
  status                    TeacherStatus @default(PENDING)
  googleCalendarConnected   Boolean       @default(false)
  googleCalendarRefreshToken String?      @db.Text
  certificates              String[]      @default([])
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability     TeacherAvailability[]
  enrollments      Enrollment[]
  demoClasses      DemoClass[]         @relation("TeacherDemos")
  scheduledClasses ScheduledClass[]    @relation("TeacherClasses")
  assignments      Assignment[]        @relation("TeacherAssignments")
  studyPlans       StudyPlan[]
  payouts          TeacherPayout[]
  reviews          Review[]            @relation("TeacherReviews")

  @@index([subjects])
  @@index([status])
  @@index([rating])
  @@map("teacher_profiles")
}

// ============================================
// AVAILABILITY
// ============================================

model TeacherAvailability {
  id               String    @id @default(uuid())
  teacherProfileId String
  dayOfWeek        DayOfWeek
  startTime        String    // "HH:mm" format e.g. "09:00"
  endTime          String    // "HH:mm" format e.g. "17:00"
  isRecurring      Boolean   @default(true)
  specificDate     DateTime? // For one-off availability overrides
  isAvailable      Boolean   @default(true) // false = blocked
  createdAt        DateTime  @default(now())

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId, dayOfWeek])
  @@map("teacher_availability")
}

model StudentAvailability {
  id               String    @id @default(uuid())
  studentProfileId String
  dayOfWeek        DayOfWeek
  startTime        String    // "HH:mm"
  endTime          String    // "HH:mm"
  createdAt        DateTime  @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId, dayOfWeek])
  @@map("student_availability")
}

// ============================================
// SYLLABUS & STUDY PLAN
// ============================================

model Syllabus {
  id               String         @id @default(uuid())
  studentProfileId String
  title            String
  fileUrl          String
  fileType         String
  structuredContent Json?          // AI-parsed content
  status           SyllabusStatus @default(UPLOADED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  studyPlans     StudyPlan[]

  @@map("syllabi")
}

model StudyPlan {
  id               String          @id @default(uuid())
  studentProfileId String
  teacherProfileId String?
  syllabusId       String?
  weeklyPlan       Json            // [{week: 1, topics: [...], assignments: [...]}]
  topicSequence    Json            // Ordered topic list
  startDate        DateTime?
  endDate          DateTime?
  status           StudyPlanStatus @default(DRAFT)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile? @relation(fields: [teacherProfileId], references: [id])
  syllabus       Syllabus?       @relation(fields: [syllabusId], references: [id])

  @@map("study_plans")
}

// ============================================
// ENROLLMENT & CLASSES
// ============================================

model Enrollment {
  id               String           @id @default(uuid())
  studentProfileId String
  teacherProfileId String
  subject          String
  status           EnrollmentStatus @default(DEMO_PENDING)
  classesPerWeek   Int              @default(3)
  classDuration    Int              @default(60) // minutes
  monthlyFee       Int?             // in INR
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile    @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  demoClasses      DemoClass[]
  scheduledClasses ScheduledClass[]
  assignments      Assignment[]
  payments         Payment[]
  subscriptions    Subscription[]
  reviews          Review[]

  @@unique([studentProfileId, teacherProfileId, subject])
  @@index([status])
  @@map("enrollments")
}

model DemoClass {
  id               String      @id @default(uuid())
  enrollmentId     String
  studentProfileId String
  teacherProfileId String
  scheduledAt      DateTime
  duration         Int         @default(30) // minutes
  meetLink         String?
  calendarEventId  String?
  status           ClassStatus @default(SCHEDULED)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation("StudentDemos", fields: [studentProfileId], references: [id])
  teacherProfile TeacherProfile @relation("TeacherDemos", fields: [teacherProfileId], references: [id])
  feedbacks      DemoFeedback[]

  @@index([scheduledAt])
  @@map("demo_classes")
}

model DemoFeedback {
  id                 String       @id @default(uuid())
  demoClassId        String
  givenByUserId      String
  feedbackType       FeedbackType
  rating             Int          // 1-5
  responses          Json         // Structured feedback form data
  comments           String?      @db.Text
  compatibilityScore Float?       // 0-100
  wouldContinue      Boolean      @default(false)
  createdAt          DateTime     @default(now())

  demoClass DemoClass @relation(fields: [demoClassId], references: [id], onDelete: Cascade)
  givenBy   User      @relation(fields: [givenByUserId], references: [id])

  @@unique([demoClassId, givenByUserId])
  @@map("demo_feedbacks")
}

model ScheduledClass {
  id               String      @id @default(uuid())
  enrollmentId     String
  teacherProfileId String
  studentProfileId String
  subject          String
  topic            String?
  scheduledAt      DateTime
  duration         Int         @default(60) // minutes
  meetLink         String?
  calendarEventId  String?
  status           ClassStatus @default(SCHEDULED)
  teacherNotes     String?     @db.Text
  studentNotes     String?     @db.Text
  teacherAttended  Boolean     @default(false)
  studentAttended  Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile @relation("TeacherClasses", fields: [teacherProfileId], references: [id])
  studentProfile StudentProfile @relation("StudentClasses", fields: [studentProfileId], references: [id])
  assignments    Assignment[]

  @@index([scheduledAt])
  @@index([teacherProfileId, scheduledAt])
  @@index([studentProfileId, scheduledAt])
  @@map("scheduled_classes")
}

// ============================================
// ASSIGNMENTS
// ============================================

model Assignment {
  id               String           @id @default(uuid())
  teacherProfileId String
  studentProfileId String
  enrollmentId     String
  scheduledClassId String?
  title            String
  description      String?          @db.Text
  subject          String
  topic            String?
  questions        Json?            // [{question: "...", type: "...", marks: 5}]
  attachmentUrls   String[]         @default([])
  deadline         DateTime
  totalMarks       Int              @default(100)
  difficulty       Difficulty       @default(MEDIUM)
  status           AssignmentStatus @default(ASSIGNED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  teacherProfile TeacherProfile        @relation("TeacherAssignments", fields: [teacherProfileId], references: [id])
  studentProfile StudentProfile        @relation("StudentAssignments", fields: [studentProfileId], references: [id])
  enrollment     Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  scheduledClass ScheduledClass?       @relation(fields: [scheduledClassId], references: [id])
  submission     AssignmentSubmission?

  @@index([studentProfileId, status])
  @@index([deadline])
  @@map("assignments")
}

model AssignmentSubmission {
  id               String    @id @default(uuid())
  assignmentId     String    @unique
  studentProfileId String
  fileUrls         String[]  @default([])
  textResponse     String?   @db.Text
  submittedAt      DateTime  @default(now())
  marksObtained    Int?
  feedback         String?   @db.Text
  correctedFileUrl String?
  gradedAt         DateTime?

  assignment     Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@map("assignment_submissions")
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id                 String        @id @default(uuid())
  studentProfileId   String
  enrollmentId       String
  amount             Int           // in paise
  platformCommission Int           @default(0) // in paise
  teacherEarnings    Int           @default(0) // in paise
  currency           String        @default("INR")
  razorpayOrderId    String?       @unique
  razorpayPaymentId  String?       @unique
  razorpaySignature  String?
  status             PaymentStatus @default(PENDING)
  type               PaymentType   @default(ONE_TIME)
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id])

  @@index([status])
  @@index([studentProfileId])
  @@map("payments")
}

model Subscription {
  id                     String             @id @default(uuid())
  studentProfileId       String
  enrollmentId           String
  razorpaySubscriptionId String?            @unique
  razorpayPlanId         String?
  amount                 Int                // in paise
  status                 SubscriptionStatus @default(CREATED)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id])

  @@map("subscriptions")
}

model TeacherPayout {
  id               String       @id @default(uuid())
  teacherProfileId String
  amount           Int          // in paise (net after commission)
  periodEarnings   Int          // in paise (gross)
  commission       Int          // in paise
  status           PayoutStatus @default(PENDING)
  transactionRef   String?
  periodStart      DateTime
  periodEnd        DateTime
  processedAt      DateTime?
  createdAt        DateTime     @default(now())

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  @@index([teacherProfileId])
  @@index([status])
  @@map("teacher_payouts")
}

// ============================================
// REVIEWS & COMMUNICATION
// ============================================

model Review {
  id               String   @id @default(uuid())
  studentProfileId String
  teacherProfileId String
  enrollmentId     String
  rating           Int      // 1-5
  title            String?
  comment          String?  @db.Text
  isPublic         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation("StudentReviews", fields: [studentProfileId], references: [id])
  teacherProfile TeacherProfile @relation("TeacherReviews", fields: [teacherProfileId], references: [id])
  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id])

  @@unique([studentProfileId, enrollmentId])
  @@map("reviews")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType    @default(SYSTEM)
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean             @default(false)
  actionUrl String?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Message {
  id             String   @id @default(uuid())
  senderId       String
  receiverId     String
  enrollmentId   String?
  content        String   @db.Text
  attachmentUrls String[] @default([])
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
  @@map("messages")
}

// ============================================
// PLATFORM CONFIGURATION
// ============================================

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

model Holiday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime @db.Date
  isGlobal  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([date])
  @@map("holidays")
}
